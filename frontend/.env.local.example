# ==============================================================================
# SUPABASE CONFIGURATION - INOX STORE FRONTEND
# ==============================================================================
# Obtenha estas credenciais no painel do Supabase:
# Acesse: https://supabase.com/dashboard -> Seu Projeto -> Project Settings -> API

# URL pública da sua API Supabase (Exemplo: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima pública (anon public key) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave privada Service Role do Supabase (APENAS servidor/webhooks — nunca usar NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Lista separada por vírgula de e-mails autorizados no painel /admin (além de profiles.role = 'admin')
# Exemplo: ADMIN_EMAILS=admin@evorah.com.br,socio@evorah.com.br
ADMIN_EMAILS=admin@evorah.com.br

# Google OAuth (configurar no Supabase Dashboard -> Authentication -> Providers -> Google)
# Redirect URL a cadastrar no Supabase -> Authentication -> URL Configuration:
# https://seu-dominio.com/auth/callback e http://localhost:3000/auth/callback

# (Opcional) API REST legada, caso queira manter o NestJS como fallback
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ==============================================================================
# GATEWAY DE PAGAMENTO (Mercado Pago - PIX & Cartão Transparente + Webhook)
# ==============================================================================
# Painel: https://www.mercadopago.com.br/developers/panel -> Suas Aplicações -> Credenciais
# Public Key vai para o navegador (CardPayment Brick)
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui

# Access Token é secreto e fica apenas no servidor (Next.js Route Handlers)
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui

# Assinatura secreta do Webhook (Webhooks -> Configurar notificações -> Assinatura secreta)
# MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-aqui

# URL pública HTTPS do seu site para receber notificações do Webhook (ex.: https://sualoja.com.br ou túnel ngrok/cloudflared)
# NEXT_PUBLIC_SITE_URL=https://seu-dominio-ou-tunel.com

# ==============================================================================
# PROTEÇÃO ANTI-ROBÔ (Cloudflare Turnstile — Login, Cadastro, Recuperação e Checkout)
# ==============================================================================
# Crie gratuitamente em: https://dash.cloudflare.com/ -> Turnstile -> Add Widget
# Chave pública (vai para o navegador):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
#
# Chave secreta (APENAS servidor — também colar no Supabase -> Authentication -> Attack Protection):
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
